<view class="page">

  <!-- ================= 语言切换 ================= -->
  <view class="langbar">
    <text class="langbar-label">{{t.lang_label}}</text>
    <view class="lang-btn" hover-class="lang-btn-hover" bindtap="switchLang">
      <text class="lang-btn-cur">{{lang === 'zh' ? '中文' : 'English'}}</text>
      <text class="lang-btn-arrow">⇄</text>
      <text class="lang-btn-next">{{t.lang_switchTo}}</text>
    </view>
  </view>

  <!-- ================= 接龙简介 ================= -->
  <view class="card intro">
    <view class="intro-head">
      <text class="intro-title">{{solitaire.title}}</text>
      <view class="status status-{{solitaire.status}}">{{solitaire.statusText}}</view>
    </view>

    <view class="owner-badge" wx:if="{{solitaire.isOwner}}">{{t.owner_badge}}</view>

    <view class="intro-desc">{{solitaire.desc}}</view>

    <view class="meta">
      <view class="meta-item">
        <text class="meta-k">{{t.intro_host}}</text>
        <text class="meta-v">{{solitaire.host}}</text>
      </view>
      <view class="meta-item">
        <text class="meta-k">{{t.intro_location}}</text>
        <text class="meta-v">{{solitaire.location}}</text>
      </view>
      <view class="meta-item">
        <text class="meta-k">{{t.intro_deadline}}</text>
        <text class="meta-v">{{solitaire.deadlineFullText}}</text>
      </view>
    </view>

    <view class="progress-wrap">
      <view class="progress-top">
        <text class="progress-label">{{solitaire.joinedText}}</text>
        <text class="progress-left">{{solitaire.quotaLeftText}}</text>
      </view>
      <view class="progress-bar" wx:if="{{solitaire.quota > 0}}">
        <view class="progress-inner" style="width:{{solitaire.percent}}%"></view>
      </view>
      <view class="deadline-tip">{{solitaire.deadlineText}}</view>
    </view>

    <!-- 管理入口：仅发起人可见 -->
    <view class="owner-entry" wx:if="{{solitaire.isOwner}}" bindtap="openAdmin">
      <text class="owner-entry-t">{{t.owner_manage}}</text>
      <text class="owner-entry-arrow">›</text>
    </view>
  </view>

  <!-- ================= 接龙者名单 ================= -->
  <view class="sec-title">
    <view class="left">
      <view class="bar"></view>
      <text class="t">{{t.list_title}}</text>
    </view>
    <text class="count">{{countText}}</text>
  </view>

  <view class="card list-card">
    <block wx:if="{{participants.length > 0}}">
      <view class="p-item" wx:for="{{participants}}" wx:key="id">
        <view class="p-seq">{{item.seq}}</view>

        <view class="p-avatar">
          <image class="p-avatar-img" src="{{item.avatar}}" mode="aspectFill" wx:if="{{item.avatar}}"></image>
          <text class="p-avatar-txt" wx:else>{{item.initial}}</text>
        </view>

        <view class="p-main">
          <view class="p-line">
            <text class="p-name">{{item.name}}</text>
            <view class="p-mine" wx:if="{{item.mine}}">{{t.list_mine}}</view>
            <view class="p-owner" wx:if="{{item.isOwner}}">{{t.intro_host}}</view>
            <view class="p-src p-src-{{item.source}}">{{item.sourceText}}</view>
          </view>
          <view class="p-remark" wx:if="{{item.remark}}">{{item.remark}}</view>
          <view class="p-time">{{item.timeText}}</view>
        </view>

        <!-- 发起人可移除他人记录；自己那条走底部「取消接龙」 -->
        <view
          class="p-remove"
          wx:if="{{solitaire.isOwner && !item.mine}}"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
          catchtap="removeEntry"
        >{{t.owner_remove}}</view>
      </view>
    </block>

    <view class="empty" wx:else>
      <text class="empty-t">{{t.list_emptyTitle}}</text>
      <text class="empty-s">{{t.list_emptySub}}</text>
    </view>
  </view>

  <view class="foot-space"></view>
</view>

<!-- ================= 底部操作栏 ================= -->
<view class="footer">
  <view class="footer-tip" wx:if="{{mine}}">{{footerTipText}}</view>
  <view class="footer-inner">
    <button class="btn btn-line btn-flex" wx:if="{{mine}}" bindtap="cancelMine">{{t.footer_cancel}}</button>
    <button
      class="btn btn-primary btn-flex"
      hover-class="btn-hover"
      wx:if="{{solitaire.canJoin}}"
      bindtap="openJoin"
    >{{mine ? t.footer_edit : t.footer_join}}</button>
    <button class="btn btn-disabled btn-flex" wx:if="{{!solitaire.canJoin && !mine}}" disabled="true">{{solitaire.statusText}}</button>
  </view>
  <view class="safe-bottom"></view>
</view>

  <!-- ================= 接龙弹窗 ================= -->
<view class="mask" wx:if="{{showJoin}}" bindtap="closeJoin" catchtouchmove="noop"></view>
<view class="sheet {{showJoin ? 'sheet-in' : ''}}" wx:if="{{showJoin}}" style="max-height:{{sheetMaxH}}px">
  <view class="sheet-head">
    <text class="sheet-title">{{t.sheet_title}}</text>
    <view class="sheet-close" bindtap="closeJoin">×</view>
  </view>

  <!-- 内容区可滚动：高度由 JS 按窗口算好（px），不依赖 vh / flex 收缩 -->
  <scroll-view class="sheet-body" scroll-y style="max-height:{{sheetBodyH}}px">

  <!-- 头像：open-type=chooseAvatar 走官方头像选择能力 -->
  <view class="form-row avatar-row">
    <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <image class="avatar-img" src="{{form.avatar}}" mode="aspectFill" wx:if="{{form.avatar}}"></image>
      <text class="avatar-txt" wx:else>{{formInitial}}</text>
    </button>
    <view class="avatar-tip">
      <text class="avatar-tip-t">{{t.sheet_avatarTitle}}</text>
      <text class="avatar-tip-s">{{t.sheet_avatarSub}}</text>
    </view>
  </view>

  <!-- 名称来源：微信昵称 / 手动填写，选中微信昵称时输入框唤起官方昵称键盘 -->
  <view class="form-row">
    <view class="form-label">
      <text class="form-label-t">{{t.sheet_name}}</text>
      <text class="form-label-s">{{t.sheet_required}}</text>
    </view>

    <view class="seg">
      <view
        class="seg-item {{form.source === 'wechat' ? 'seg-on' : ''}}"
        data-source="wechat"
        bindtap="switchSource"
      >{{t.sheet_tabWechat}}</view>
      <view
        class="seg-item {{form.source === 'manual' ? 'seg-on' : ''}}"
        data-source="manual"
        bindtap="switchSource"
      >{{t.sheet_tabManual}}</view>
    </view>

    <!-- 一键填入：唤起微信官方昵称键盘，键盘上方直接显示你的微信昵称，点一下即填入 -->
    <view class="quick" wx:if="{{form.source === 'wechat'}}" bindtap="fillWechatName">
      <text class="quick-t">{{t.sheet_quickTitle}}</text>
      <text class="quick-s">{{t.sheet_quickSub}}</text>
    </view>

    <input
      class="form-input"
      id="name-input"
      type="{{form.source === 'wechat' ? 'nickname' : 'text'}}"
      value="{{form.name}}"
      maxlength="20"
      focus="{{nameFocus}}"
      placeholder="{{form.source === 'wechat' ? t.sheet_namePhWechat : t.sheet_namePhManual}}"
      placeholder-class="form-ph"
      bindinput="onNameInput"
      bindblur="onNameBlur"
    />
    <view class="form-hint">{{form.source === 'wechat' ? t.sheet_hintWechat : t.sheet_hintManual}}</view>
  </view>

  <view class="form-row">
    <view class="form-label">
      <text class="form-label-t">{{t.sheet_remark}}</text>
      <text class="form-label-s">{{t.sheet_optional}}</text>
    </view>
    <input
      class="form-input"
      value="{{form.remark}}"
      maxlength="60"
      placeholder="{{t.sheet_remarkPh}}"
      placeholder-class="form-ph"
      bindinput="onRemarkInput"
    />
  </view>

  </scroll-view>

  <view class="sheet-actions">
    <button class="btn btn-line" bindtap="closeJoin">{{t.sheet_cancel}}</button>
    <button class="btn btn-primary" hover-class="btn-hover" bindtap="submitJoin" loading="{{submitting}}" disabled="{{submitting}}">{{t.sheet_submit}}</button>
  </view>

  <view class="safe-bottom"></view>
</view>

<!-- ================= 发起人管理弹窗 ================= -->
<view class="mask" wx:if="{{showAdmin}}" bindtap="closeAdmin" catchtouchmove="noop"></view>
<view class="sheet {{showAdmin ? 'sheet-in' : ''}}" wx:if="{{showAdmin}}" style="max-height:{{sheetMaxH}}px">
  <view class="sheet-head">
    <text class="sheet-title">{{t.owner_panelTitle}}</text>
    <view class="sheet-close" bindtap="closeAdmin">×</view>
  </view>

  <!-- 内容区可滚动：管理面板字段多，这里给确定高度，滚动才生效 -->
  <scroll-view class="sheet-body" scroll-y style="height:{{sheetBodyH}}px">
  <view class="sheet-sub">{{t.owner_panelSub}}</view>

  <view class="form-row">
    <view class="form-label">
      <text class="form-label-t">{{t.owner_editTitle}}</text>
    </view>
    <input
      class="form-input"
      value="{{adminForm.title}}"
      maxlength="60"
      placeholder-class="form-ph"
      data-field="title"
      bindinput="onAdminInput"
    />
  </view>

  <view class="form-row">
    <view class="form-label">
      <text class="form-label-t">{{t.owner_editDesc}}</text>
    </view>
    <textarea
      class="form-area"
      value="{{adminForm.desc}}"
      maxlength="200"
      placeholder-class="form-ph"
      data-field="desc"
      bindinput="onAdminInput"
    ></textarea>
  </view>

  <view class="form-row">
    <view class="form-label">
      <text class="form-label-t">{{t.intro_host}}</text>
    </view>
    <input
      class="form-input"
      value="{{adminForm.host}}"
      maxlength="20"
      placeholder-class="form-ph"
      data-field="host"
      bindinput="onAdminInput"
    />
  </view>

  <view class="form-row">
    <view class="form-label">
      <text class="form-label-t">{{t.intro_location}}</text>
    </view>
    <input
      class="form-input"
      value="{{adminForm.location}}"
      maxlength="60"
      placeholder-class="form-ph"
      data-field="location"
      bindinput="onAdminInput"
    />
  </view>

  <view class="form-row">
    <view class="form-label">
      <text class="form-label-t">{{t.owner_editQuota}}</text>
    </view>
    <input
      class="form-input"
      type="number"
      value="{{adminForm.quota}}"
      placeholder="{{t.owner_quotaPh}}"
      placeholder-class="form-ph"
      data-field="quota"
      bindinput="onAdminInput"
    />
  </view>

  <view class="form-row">
    <view class="datetime">
      <view class="dt-field">
        <text class="dt-label">{{t.owner_editDeadline}}</text>
        <picker mode="date" value="{{adminForm.date}}" bindchange="onAdminDate">
          <view class="dt-cell">{{adminForm.date}}</view>
        </picker>
      </view>
      <view class="dt-field">
        <text class="dt-label">{{t.owner_editTime}}</text>
        <picker mode="time" value="{{adminForm.time}}" bindchange="onAdminTime">
          <view class="dt-cell">{{adminForm.time}}</view>
        </picker>
      </view>
    </view>
  </view>

  <view class="admin-acts">
    <view class="admin-act {{solitaire.closed ? 'admin-act-on' : ''}}" bindtap="toggleClose">
      {{solitaire.closed ? t.owner_reopenAction : t.owner_closeAction}}
    </view>
  </view>

  <view class="form-row">
    <view class="form-label">
      <text class="form-label-t">{{t.owner_transfer}}</text>
    </view>
    <view class="pick-list" wx:if="{{transferList.length > 0}}">
      <view
        class="pick-item {{adminForm.transferTo === item.id ? 'pick-on' : ''}}"
        wx:for="{{transferList}}"
        wx:key="id"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        bindtap="pickTransfer"
      >
        <text class="pick-name">{{item.name}}</text>
        <text class="pick-check" wx:if="{{adminForm.transferTo === item.id}}">✓</text>
      </view>
    </view>
    <view class="pick-empty" wx:else>{{t.owner_transferEmpty}}</view>
  </view>

  </scroll-view>

  <view class="sheet-actions">
    <button class="btn btn-line" bindtap="closeAdmin">{{t.sheet_cancel}}</button>
    <button class="btn btn-primary" hover-class="btn-hover" bindtap="submitAdmin">{{t.owner_save}}</button>
  </view>

  <view class="safe-bottom"></view>
</view>

<!-- ================= 隐私授权弹窗 ================= -->
<!-- 平台要求：调用头像/昵称等隐私接口前必须取得用户同意，
     且「同意」必须走 button open-type="agreePrivacyAuthorization"，自绘按钮无效 -->
<view class="privacy-mask" wx:if="{{showPrivacy}}"></view>
<view class="privacy" wx:if="{{showPrivacy}}">
  <view class="privacy-title">{{t.privacy_title}}</view>
  <view class="privacy-body">
    <text>{{t.privacy_pre}}</text>
    <text class="privacy-link" bindtap="openPrivacyContract">{{privacyName}}</text>
    <text>{{t.privacy_post}}</text>
  </view>
  <view class="privacy-actions">
    <button class="privacy-btn privacy-btn-line" bindtap="onDisagreePrivacy">{{t.privacy_disagree}}</button>
    <button
      id="agree-btn"
      class="privacy-btn privacy-btn-main"
      open-type="agreePrivacyAuthorization"
      bind:agreeprivacyauthorization="onAgreePrivacy"
    >{{t.privacy_agree}}</button>
  </view>
</view>
