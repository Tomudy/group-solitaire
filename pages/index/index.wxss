.page {
  min-height: 100vh;
  padding-top: 24rpx;
}

/* ==================== 语言切换 ==================== */
.langbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 20rpx;
}

.langbar-label {
  font-size: 24rpx;
  color: #9AA1AE;
}

.lang-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  border: 2rpx solid #E3E6EC;
}

.lang-btn-hover {
  background: #F7F8FA;
}

.lang-btn-cur {
  font-size: 24rpx;
  font-weight: 600;
  color: #FF6B35;
}

.lang-btn-arrow {
  margin: 0 10rpx;
  font-size: 22rpx;
  color: #C6CBD4;
}

.lang-btn-next {
  font-size: 24rpx;
  color: #6B7280;
}

/* ==================== 接龙简介 ==================== */
.intro {
  padding: 28rpx 28rpx 24rpx;
}

.intro-head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
}

.intro-title {
  flex: 1;
  font-size: 38rpx;
  font-weight: 700;
  color: #1F2430;
  line-height: 1.35;
  padding-right: 16rpx;
}

.status {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-open {
  color: #FF6B35;
  background: #FFF1EB;
}

.status-full {
  color: #E0A414;
  background: #FFF6E0;
}

.status-expired {
  color: #9AA1AE;
  background: #F4F5F8;
}

.intro-desc {
  margin-top: 18rpx;
  font-size: 27rpx;
  line-height: 1.65;
  color: #4B5563;
}

.meta {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  background: #FAFBFC;
  border-radius: 12rpx;
}

.meta-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 6rpx 0;
}

/* 宽度自适应：英文 Deadline 等比中文长，固定宽度会挤压或截断；
   margin-right 保证标签与值之间在任何语言下都有固定间距 */
.meta-k {
  width: auto;
  min-width: 96rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #9AA1AE;
}

.meta-v {
  flex: 1;
  font-size: 26rpx;
  color: #374151;
}

/* ==================== 进度 ==================== */
.progress-wrap {
  margin-top: 24rpx;
}

.progress-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.progress-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #1F2430;
}

.progress-left {
  font-size: 24rpx;
  color: #FF6B35;
  flex-shrink: 0;
  padding-left: 12rpx;
}

.progress-bar {
  margin-top: 14rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: #F0F1F4;
  overflow: hidden;
}

.progress-inner {
  height: 12rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #FF8C42, #FF6B35);
}

.deadline-tip {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #9AA1AE;
}

/* ==================== 名单列表 ==================== */
.list-card {
  padding: 4rpx 28rpx;
}

.p-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F2F3F6;
}

.p-item:last-child {
  border-bottom: none;
}

.p-seq {
  width: 44rpx;
  flex-shrink: 0;
  padding-top: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #C6CBD4;
  text-align: center;
}

.p-avatar {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  border-radius: 38rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #FF8C42, #FF6B35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.p-avatar-img {
  width: 76rpx;
  height: 76rpx;
}

.p-avatar-txt {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.p-main {
  flex: 1;
  min-width: 0;
}

.p-line {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.p-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #1F2430;
  max-width: 300rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.p-mine {
  margin-left: 10rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 19rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: #FF6B35;
}

.p-src {
  margin-left: 10rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 19rpx;
}

.p-src-wechat {
  color: #2FBF71;
  background: #E8F7EF;
}

.p-src-manual {
  color: #9AA1AE;
  background: #F4F5F8;
}

.p-remark {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #6B7280;
  line-height: 1.5;
}

.p-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #B4BAC4;
}

/* ==================== 空态 ==================== */
.empty {
  padding: 56rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-t {
  font-size: 28rpx;
  color: #9AA1AE;
}

.empty-s {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #C6CBD4;
}

/* ==================== 底部操作栏 ==================== */
.foot-space {
  height: 200rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 20rpx rgba(31, 36, 48, 0.06);
  z-index: 80;
}

.footer-tip {
  padding: 16rpx 32rpx 0;
  font-size: 24rpx;
  color: #FF6B35;
  text-align: center;
}

.footer-inner {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 32rpx;
}

.btn-flex {
  flex: 1;
  margin: 0 8rpx;
}

.btn-hover {
  opacity: 0.88;
}

/* ==================== 弹窗 ==================== */
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 28rpx 28rpx 0 0;
  padding: 8rpx 32rpx 0;
  z-index: 100;
  transform: translateY(100%);
  transition: transform 0.26s ease;
  display: flex;
  flex-direction: column;
  /* 高度上限由 JS 按窗口算好写在行内 style 上（sheetMaxH，px）。
     这里不再写 vh：部分 Android 机型 vh 与 flex 收缩都不可靠，
     scroll-view 会被内容撑开，把弹窗顶成全屏。 */
}

/* 可滚动内容区：高度同样由 JS 写在行内 style 上（sheetBodyH，px）。
   min-height:0 让它在空间不足时允许收缩，而不是把父容器撑破。 */
.sheet-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.sheet-body::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}

.sheet-in {
  transform: translateY(0);
}

.sheet-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  flex-shrink: 0;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2430;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 42rpx;
  color: #B4BAC4;
}

/* ==================== 表单 ==================== */
.form-row {
  padding: 20rpx 0 8rpx;
}

.form-label {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.form-label-t {
  font-size: 27rpx;
  font-weight: 600;
  color: #374151;
}

.form-label-s {
  margin-left: 10rpx;
  font-size: 21rpx;
  color: #C6CBD4;
}

.form-input {
  margin-top: 14rpx;
  height: 88rpx;
  padding: 0 24rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1F2430;
}

.form-ph {
  color: #B4BAC4;
}

.form-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9AA1AE;
  line-height: 1.5;
}

/* 名称来源切换 */
.seg {
  margin-top: 14rpx;
  display: flex;
  flex-direction: row;
  background: #F0F1F4;
  border-radius: 12rpx;
  padding: 6rpx;
}

.seg-item {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  color: #6B7280;
  border-radius: 10rpx;
  padding: 0 8rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.seg-on {
  background: #FFFFFF;
  color: #FF6B35;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(31, 36, 48, 0.08);
}

/* 一键填入微信昵称：唤起官方昵称键盘，键盘上方点一下即填入 */
.quick {
  margin-top: 14rpx;
  padding: 18rpx 24rpx;
  background: #FFF1EB;
  border: 2rpx solid #FFD9C7;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick:active {
  background: #FFE6DC;
}

.quick-t {
  font-size: 28rpx;
  font-weight: 600;
  color: #FF6B35;
}

.quick-s {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #C98A6B;
}

/* ==================== 头像 ==================== */
.avatar-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.avatar-btn {
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  margin: 0;
  border-radius: 60rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #FF8C42, #FF6B35);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 120rpx;
  height: 120rpx;
}

.avatar-txt {
  font-size: 46rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.avatar-tip {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.avatar-tip-t {
  font-size: 27rpx;
  color: #374151;
}

.avatar-tip-s {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #B4BAC4;
}

/* ==================== 弹窗按钮 ==================== */
.sheet-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 0 28rpx;
  flex-shrink: 0;
}

.sheet .safe-bottom {
  flex-shrink: 0;
}

.sheet-actions .btn-line {
  width: 220rpx;
  margin-right: 20rpx;
}

.sheet-actions .btn-primary {
  flex: 1;
}

/* ==================== 发起人身份标识 ==================== */
.owner-badge {
  display: inline-block;
  margin-top: 16rpx;
  padding: 6rpx 18rpx;
  border-radius: 22rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: #FF6B35;
}

/* 管理入口：整行可点，箭头靠右 */
.owner-entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F1F4;
}

.owner-entry-t {
  font-size: 27rpx;
  font-weight: 600;
  color: #FF6B35;
}

.owner-entry-arrow {
  font-size: 32rpx;
  color: #C6CBD4;
}

/* ==================== 名单 · 发起人徽标与移除按钮 ==================== */
.p-owner {
  margin-left: 10rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 19rpx;
  font-weight: 600;
  color: #7A5CFF;
  background: #F0EDFF;
}

.p-remove {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  color: #E5484D;
  background: #FDEDED;
}

/* ==================== 管理弹窗 ==================== */
.sheet-sub {
  padding-bottom: 10rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #9AA1AE;
}

.form-area {
  margin-top: 14rpx;
  width: 100%;
  /* 200rpx ≈ 5 行可见高度，说明写长了不至于只露一两行 */
  min-height: 200rpx;
  padding: 20rpx 24rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: #1F2430;
}

/* 日期与时间并排：两个 picker 等宽，英文日期也不会挤在一起 */
.datetime {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 14rpx;
}

.dt-field {
  flex: 1;
  min-width: 0;
}

.dt-field:first-child {
  margin-right: 16rpx;
}

.dt-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: #9AA1AE;
}

.dt-cell {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1F2430;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.admin-acts {
  padding: 10rpx 0 6rpx;
}

.admin-act {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #E5484D;
  background: #FDEDED;
}

.admin-act-on {
  color: #2FBF71;
  background: #E8F7EF;
}

/* ==================== 转让选人 ==================== */
.pick-list {
  margin-top: 14rpx;
}

.pick-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 84rpx;
  padding: 0 24rpx;
  margin-bottom: 12rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
}

.pick-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1F2430;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.pick-check {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #FF6B35;
}

.pick-on {
  background: #FFF1EB;
}

.pick-empty {
  margin-top: 14rpx;
  padding: 28rpx 24rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  font-size: 25rpx;
  color: #B4BAC4;
  text-align: center;
}

/* ==================== 空态引导 ==================== */
.empty-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 40rpx 48rpx;
}

.empty-hero-icon {
  width: 108rpx;
  height: 108rpx;
  margin-bottom: 26rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF8C42, #FF5A1F);
  color: #FFFFFF;
  font-size: 58rpx;
  line-height: 104rpx;
  text-align: center;
}

.empty-hero-t {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1D24;
}

.empty-hero-s {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #8A9099;
  text-align: center;
}

.empty-hero-btn {
  width: 100%;
  margin-top: 40rpx;
}


/* ============ 隐私授权弹窗 ============ */
/* 层级要高于接龙/管理弹窗（z-index 100），否则会被盖住 */
.privacy-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 300;
}

.privacy {
  position: fixed;
  top: 50%;
  left: 56rpx;
  right: 56rpx;
  transform: translateY(-50%);
  padding: 48rpx 40rpx 32rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  z-index: 301;
}

.privacy-title {
  margin-bottom: 24rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
  text-align: center;
}

.privacy-body {
  margin-bottom: 40rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #5A5A5A;
}

/* 协议名：可点开完整原文 */
.privacy-link {
  color: #FF6B35;
}

.privacy-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.privacy-btn {
  flex: 1;
  height: 84rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 1.2;
  border-radius: 42rpx;
}

/* 小程序 button 自带一圈 ::after 边框，去掉才好看 */
.privacy-btn::after {
  border: none;
}

.privacy-btn + .privacy-btn {
  margin-left: 20rpx;
}

.privacy-btn-line {
  background: #F2F3F5;
  color: #6B6B6B;
}

.privacy-btn-main {
  background: #FF6B35;
  color: #FFFFFF;
  font-weight: 500;
}
